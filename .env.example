NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
APP_NAME=DARFIN BOOK
APP_LOCALE=id-ID
DEFAULT_BOOK_LANGUAGE=id
STRICT_INDONESIAN_CATALOG=true

# Database: SQLite local path or PostgreSQL / Supabase URL
DATABASE_PATH=./data/darfin_book.db
DATABASE_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINI_APP_URL=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400

GOOGLE_BOOKS_API_KEY=
OPEN_LIBRARY_USER_AGENT=DarfinBook/1.0 (contact: support@darfinbook.id)
OPEN_LIBRARY_CONTACT_EMAIL=support@darfinbook.id
WIKISOURCE_API_BASE_URL=https://id.wikisource.org/w/api.php

JWT_SECRET=super-secret-darfin-book-jwt-key-change-in-production
SESSION_SECRET=super-secret-session-key

LOG_LEVEL=info
